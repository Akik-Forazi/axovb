{
  "name": "@fraziym/axovb",
  "version": "0.1.2-beta.3",
  "description": "Axo Version Bumper — small LLM that detects forgotten version bumps and does them automatically. Works with any coding agent. $0.90/mo.",
  "author": "Akik Faraji <akikfaraji@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Akik-Forazi/axovb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akik-Forazi/axovb.git"
  },
  "bugs": {
    "url": "https://github.com/Akik-Forazi/axovb/issues"
  },
  "keywords": [
    "version",
    "versioning",
    "frazyim",
    "bump",
    "automation",
    "ci",
    "semver",
    "agent"
  ],
  "type": "module",
  "bin": {
    "axovb": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "node --test --experimental-strip-types test/version.test.ts"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "onnxruntime-node": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
